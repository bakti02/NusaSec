# Sample production reverse-proxy config for nusasec-website.
#
# Serves the static site/console folders directly and forwards API traffic to
# the nusasec-core service, so both are on one origin (recommended: keeps the
# session cookie SameSite=Lax and avoids needing CORS). Adjust
# `core_api_upstream` to wherever nusasec-core is deployed.

upstream core_api_upstream {
    server 127.0.0.1:8000;
}

server {
    listen 443 ssl http2;
    server_name www.example.com;

    # ssl_certificate ...;
    # ssl_certificate_key ...;

    root /var/www/nusasec-website;

    location = / {
        try_files /site/index.html =404;
    }

    location /site/  { try_files $uri $uri/ =404; }
    location /app/   { alias /var/www/nusasec-website/web/;      try_files $uri $uri/ =404; }
    location /internal/ { try_files $uri $uri/ =404; }
    location /login/ { try_files $uri $uri/ =404; }
    location /design/ { try_files $uri $uri/ =404; }
    location /shared/ { try_files $uri $uri/ =404; }

    # Everything the backend needs to answer directly.
    location ~ ^/(api|health|docs|redoc|openapi\.json) {
        proxy_pass http://core_api_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

# nusasec-next (cms-next) is a separate Next.js app; deploy/run it
# independently (e.g. `next start` behind its own upstream, or on a platform
# like Vercel) and route /cms/ or a dedicated subdomain to it.
